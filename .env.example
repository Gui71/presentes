# Copie para .env. Gere SECRET_KEY conforme o README; não use este marcador.
APP_ENV=development
SECRET_KEY=CHANGE-ME-gere-uma-chave-local
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Em produção: https://seu-dominio (sem barra final), separado por vírgula.
CSRF_TRUSTED_ORIGINS=
# Caminhos relativos à raiz do projeto ou caminhos absolutos, fora da pasta pública.
DATABASE_PATH=db.sqlite3
MEDIA_ROOT=media
STATIC_ROOT=staticfiles
# Docker/Compose: domínio real, sem esquema, porta ou caminho. Para teste local: localhost.
SITE_DOMAIN=
# Apenas para o runner de testes; nunca aponte ao banco de uso normal.
TEST_DATABASE_PATH=.test.sqlite3
# Produção requer HTTPS. Ative confiança no proxy SOMENTE se ele remover
# X-Forwarded-Proto recebido do cliente e definir seu próprio valor.
TRUST_PROXY_HTTPS=false
# Ative HSTS somente após validar HTTPS em todos os domínios envolvidos.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
